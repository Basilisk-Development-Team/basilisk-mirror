+#if PLATFORM(GTK) || PLATFORM(WPE)
+void NetworkResourceLoader::decideResourcePolicy(ResourceRequest request, ResourceResponse response, bool isResponse, CompletionHandler<void(ResourceRequest&&, ResourceResponse&&)>&& completion)
+{
+    if (!m_parameters.resourceLoadPolicyEnabled) {
+        completion(WTF::move(request), WTF::move(response));
+        return;
+    }
+    auto info = resourceLoadInfo();
+    auto snapshot = NetworkResourcePolicy::snapshot(request, response, isResponse);
+    snapshot->setString("id"_s, String::number(info.resourceLoadID.toUInt64()));
+    snapshot->setString("frameId"_s, info.frameID ? String::number(info.frameID->toUInt64()) : emptyString());
+    snapshot->setString("parentFrameId"_s, info.parentFrameID ? String::number(info.parentFrameID->toUInt64()) : emptyString());
+    snapshot->setString("documentId"_s, info.documentID ? info.documentID->toString() : emptyString());
+    snapshot->setString("documentURL"_s, m_parameters.documentURL.string());
+    snapshot->setString("originalURL"_s, info.originalURL.string());
+    snapshot->setString("sourceOrigin"_s, m_parameters.sourceOrigin ? m_parameters.sourceOrigin->toString() : emptyString());
+    snapshot->setString("topOrigin"_s, m_parameters.topOrigin ? m_parameters.topOrigin->toString() : emptyString());
+    snapshot->setInteger("type"_s, static_cast<int>(info.type));
+    snapshot->setBoolean("mainResource"_s, isMainResource());
+    snapshot->setBoolean("mainFrame"_s, isMainFrameLoad());
+    snapshot->setInteger("redirectCount"_s, m_redirectCount);
+    auto serialized = snapshot->toJSONString();
+    m_resourcePolicy = NetworkResourcePolicy::create([weakThis = WeakPtr { *this }, request = WTF::move(request), response = WTF::move(response), isResponse, completion = WTF::move(completion)](RefPtr<JSON::Object>&& decision) mutable {
+        if (!weakThis || weakThis->m_resourcePolicyCancelled) {
+            completion({ }, { });
+            return;
+        }
+        RefPtr loader = weakThis.get();
+        if (!decision || !decision->getBoolean("allow"_s).value_or(false)) {
+            completion({ }, { });
+            if (!loader->m_resourcePolicyCancelled)
+                loader->didFailLoading(ResourceError { "WebKitResourcePolicy"_s, 1, request.url(), "Blocked by resource policy"_s });
+            return;
+        }
+        if (isResponse)
+            NetworkResourcePolicy::applyHeaders(response, *decision);
+        else {
+            NetworkResourcePolicy::applyHeaders(request, *decision);
+            auto redirect = decision->getString("redirectURL"_s);
+            if (!redirect.isEmpty()) {
+                URL url { redirect };
+                if (!url.isValid() || !(url.protocolIsInHTTPFamily() || url.protocolIsData())) {
+                    completion({ }, { });
+                    if (!loader->m_resourcePolicyCancelled)
+                        loader->didFailLoading(ResourceError { "WebKitResourcePolicy"_s, 2, request.url(), "Invalid policy redirect"_s });
+                    return;
+                }
+                request.setURL(WTF::move(url));
+            }
+        }
+        completion(WTF::move(request), WTF::move(response));
+    });
+    m_resourcePolicy->start(*connectionToWebProcess().networkProcess().parentProcessConnection(), webPageProxyID(), serialized);
+}
+#endif
 
