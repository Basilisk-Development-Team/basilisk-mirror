XPIDL_SOURCES += ['nsIWebContentView.idl']
XPIDL_MODULE = 'webcontentview'
SOURCES += ['WebKitContentView.cpp']
FINAL_LIBRARY = 'xul'
LOCAL_INCLUDES += ['/dom/base', '/widget/gtk']
CXXFLAGS += CONFIG['WPE_WEBKIT_CFLAGS']
CXXFLAGS += CONFIG['WPE_PLATFORM_CFLAGS']
CXXFLAGS += CONFIG['TK_CFLAGS']
OS_LIBS += CONFIG['WPE_WEBKIT_LIBS']
OS_LIBS += CONFIG['WPE_PLATFORM_LIBS']
