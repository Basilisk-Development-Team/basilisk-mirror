@@ -31,6 +31,34 @@
 
 namespace TestWebKitAPI {
 
+#if OS(DARWIN) && USE(UNIX_DOMAIN_SOCKETS)
+TEST(IPCSemaphoreDarwin, CountedSignalsAndTimeout)
+{
+    IPC::Semaphore semaphore;
+    ASSERT_TRUE(semaphore);
+    EXPECT_FALSE(semaphore.waitFor(IPC::Timeout::now()));
+    for (unsigned i = 0; i < 100000; ++i)
+        semaphore.signal();
+    for (unsigned i = 0; i < 100000; ++i)
+        ASSERT_TRUE(semaphore.waitFor(IPC::Timeout::now()));
+    EXPECT_FALSE(semaphore.waitFor(IPC::Timeout(1_ms)));
+}
+
+TEST(IPCSemaphoreDarwin, DuplicateOutlivesOriginal)
+{
+    auto duplicate = [] {
+        IPC::Semaphore original;
+        original.signal();
+        return IPC::Semaphore(original.duplicateDescriptor());
+    }();
+    auto moved = WTF::move(duplicate);
+    EXPECT_FALSE(duplicate);
+    ASSERT_TRUE(moved);
+    EXPECT_TRUE(moved.waitFor(IPC::Timeout::now()));
+    EXPECT_FALSE(moved.waitFor(IPC::Timeout::now()));
+}
+#endif
+
