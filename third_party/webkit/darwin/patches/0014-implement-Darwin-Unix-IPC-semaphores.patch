+#if OS(DARWIN)
+static bool waitImpl(WebCore::SharedMemory& memory, Timeout timeout)
+{
+    auto& value = counter(memory);
+    for (;;) {
+        auto current = value.load(std::memory_order_relaxed);
+        while (current) {
+            if (value.compare_exchange_weak(current, current - 1, std::memory_order_acquire, std::memory_order_relaxed))
+                return true;
+        }
+        // The kernel atomically compares and waits. A signal between our load
+        // and this call cannot be lost. Shared mode keys the wait to the memory
+        // object, not the virtual address used by an individual process.
+        int result;
+        if (timeout.isInfinity())
+            result = os_sync_wait_on_address(&value, 0, sizeof(uint64_t), OS_SYNC_WAIT_ON_ADDRESS_SHARED);
+        else {
+            auto remaining = timeout.secondsUntilDeadline();
+            if (remaining <= 0_s)
+                return false;
+            result = os_sync_wait_on_address_with_timeout(&value, 0, sizeof(uint64_t),
+                OS_SYNC_WAIT_ON_ADDRESS_SHARED, OS_CLOCK_MACH_ABSOLUTE_TIME,
+                std::max<uint64_t>(1, remaining.nanosecondsAs<uint64_t>()));
+        }
+        if (result < 0 && errno != EINTR)
+            return false;
+    }
+}
+#endif
