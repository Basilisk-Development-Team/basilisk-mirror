#include "nsISupports.idl"
interface mozIDOMWindowProxy;
interface nsIContentViewObserver;
interface nsIContentRequestRule;

/** Experimental chrome-only content view. No Gecko DOM/docshell contract.
 * All calls and callbacks occur on the main thread. The owner must destroy()
 * on window unload. Coordinates are device pixels, relative to
 * the chrome window's client area. The chrome owner manages tab visibility
 * and must keep the native host inside its content rectangle.
 */
[scriptable, uuid(3bf51e5b-727a-469a-a30d-9f6b1debd3a2)]
interface nsIWebContentView : nsISupports
{
  const unsigned long CAP_DEVTOOLS = 0x0001;
  const unsigned long CAP_INSPECT_ELEMENT = 0x0002;
  const unsigned long CAP_FULLSCREEN = 0x0004;
  const unsigned long CAP_DOWNLOADS = 0x0008;
  const unsigned long CAP_CONTENT_SCRIPTS = 0x0010;
  const unsigned long CAP_ISOLATED_CONTENT_WORLD = 0x0020;
  const unsigned long CAP_PERSISTENT_STORAGE = 0x0040;
  const unsigned long CAP_PRIVATE_STORAGE = 0x0080;
  const unsigned long CAP_AUDIO_CONTROL = 0x0100;
  const unsigned long CAP_CSS = 0x0200;
  const unsigned long CAP_SCRIPT_REGISTRATION = 0x0400;
  const unsigned long CAP_MESSAGING = 0x0800;
  const unsigned long CAP_FIND = 0x1000;
  const unsigned long CAP_REQUEST_FILTERING = 0x2000;
  /** Peer connections/data channels, independently of camera/microphone grants. */
  const unsigned long CAP_WEBRTC = 0x4000;
  /** Capture with trustworthy requester identity and browser permission mediation. */
  const unsigned long CAP_MEDIA_CAPTURE = 0x8000;
  const unsigned long CAP_SCRIPT_TIMING = 0x10000;
  const unsigned long CAP_FRAMES = 0x20000;
  const unsigned long CAP_EXECUTION_WORLDS = 0x40000;
  const unsigned long SCRIPT_DOCUMENT_START = 0;
  const unsigned long SCRIPT_DOCUMENT_END = 1;
  const unsigned long SCRIPT_DOCUMENT_IDLE = 2;
  /** Available in this view's configuration, not an OS/version guess. */
  readonly attribute unsigned long capabilities;
  /** listener topics: content-view-state (read state getters) and
   * content-view-process-terminated. Subject is this view.
   * content-view-context-menu carries an nsIPropertyBag2 subject with UTF-8
   * pageURL/linkURL/imageURL/mediaURL; boolean isLink/isImage/isMedia/
   * isEditable/hasSelection; and int32 x/y in host device pixels.
   * Selected text is not available in the prototype.
   */
  /** userContextId selects an isolated container storage partition. */
  void attach(in mozIDOMWindowProxy window, in nsIContentViewObserver listener,
              [optional] in unsigned long userContextId);
  void setBounds(in long x, in long y, in long width, in long height);
  void setVisible(in boolean visible);
  void focus();
  /** Return native keyboard focus to the owning chrome widget. */
  void blur();
  /** Idempotent. Disconnects callbacks and releases native/engine resources. */
  void destroy();

  void loadURI(in AUTF8String uri);
  void reload();
  void stop();
  void goBack();
  void goForward();
  readonly attribute boolean canGoBack;
  readonly attribute boolean canGoForward;
  readonly attribute AUTF8String currentURI;
  readonly attribute AUTF8String title;
  readonly attribute AUTF8String engineId;
  readonly attribute boolean loading;
  readonly attribute boolean focused;
  readonly attribute AUTF8String lastError;
  attribute double zoom;
  attribute boolean muted;
  readonly attribute boolean audioPlaying;
  readonly attribute boolean cameraActive;
  readonly attribute boolean microphoneActive;
  readonly attribute boolean screenCaptureActive;
  /** Plain-text editing commands: copy, cut, paste, selectAll. */
  void edit(in AUTF8String command);
  void find(in AUTF8String text, in boolean backwards, in boolean caseSensitive);
  void findAgain(in boolean backwards);
  void clearFind();
  /** Upstream inspector. Context inspection requires a retained menu action. */
  void openDeveloperTools();
  void inspectElement();
  /** Acknowledge XUL-controlled fullscreen state to the content backend. */
  void setFullscreen(in boolean active);
  /** Async function body in the isolated Basilisk world. Replies are JSON. */
  void executeScript(in unsigned long requestId, in AUTF8String source);
  /** Opaque document-lifetime frame identities, never DOM/native pointers. */
  void getFrames(in unsigned long requestId);
  void executeFrameScript(in unsigned long requestId, in AUTF8String frameId, in AUTF8String source);
  /** Privileged opaque world key, scoped to this frame document. globalScope
   * evaluates a script at global scope (completion value discarded); otherwise
   * source is an async function body with a JSON result. No closure transport. */
  void executeWorldScript(in unsigned long requestId, in AUTF8String frameId,
                          in AUTF8String worldId, in AUTF8String source,
                          in boolean globalScope);
  /** Prepare before future-document registration; release revokes pending work. */
  void prepareWorld(in unsigned long requestId, in AUTF8String worldId);
  void releaseWorld(in unsigned long requestId, in AUTF8String worldId);
  /** Global source, document-start/end only. Registration affects future documents. */
  void registerWorldScript(in AUTF8String identifier, in AUTF8String worldId,
                           in AUTF8String source, in unsigned long runAt,
                           in boolean allFrames);
  void insertCSS(in AUTF8String identifier, in AUTF8String source);
  void insertCSSWithOptions(in AUTF8String identifier, in AUTF8String source, in boolean allFrames);
  void removeCSS(in AUTF8String identifier);
  void registerScript(in AUTF8String identifier, in AUTF8String source);
  void registerScriptWithOptions(in AUTF8String identifier, in AUTF8String source,
                                 in unsigned long runAt, in boolean allFrames);
  void unregisterScript(in AUTF8String identifier);
  /** Browser-owned legacy frame-script and message-manager transport. */
  void sendLegacyMessage(in AUTF8String json);
  /** Resolve a held resource decision. Late or duplicate replies fail. */
  void completeResourcePolicy(in unsigned long identifier, in AUTF8String json);
  /** Async atomic replacement. Completion is content-view-policy-result.
   * Caller must await completion before starting a navigation to be filtered.
   * Tokens are local to this view. Unknown/unsupported rules must fail.
   */
  void setRequestRules(in unsigned long requestId, in AUTF8String identifier,
                       in unsigned long count,
                       [array, size_is(count)] in nsIContentRequestRule rules);
  void removeRequestRules(in AUTF8String identifier);
  /** Temporarily detach/reattach an already compiled policy without rebuilding
   * it. Compilation updates preserve this enabled state. Removal destroys it. */
  void setRequestRulesEnabled(in AUTF8String identifier, in boolean enabled);
  /** Complete an optional bounded top-document preparation decision. The
   * backend owns pending decisions; late completions fail safely. */
  void completeNavigationPreparation(in unsigned long decisionId, in boolean allow);
};
