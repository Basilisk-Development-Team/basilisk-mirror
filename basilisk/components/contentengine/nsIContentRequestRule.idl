#include "nsISupports.idl"
/** Declarative block rule. All unmatched requests are allowed.
 * Backend performs party classification using its registrable-domain utilities.
 * No origin inference, callback or channel emulation.
 * URL prefix is a canonical ASCII HTTP(S)/WS(S) URI, matched case-sensitively.
 * Resource types are project-owned bits; zero matches all resource classes.
 */
[scriptable, uuid(8352e210-460a-4a34-9527-05d2321e43cf)]
interface nsIContentRequestRule : nsISupports
{
  const unsigned long IMAGE = 1;
  const unsigned long STYLESHEET = 2;
  const unsigned long SCRIPT = 4;
  const unsigned long FONT = 8;
  const unsigned long MEDIA = 16;
  const unsigned long DOCUMENT = 32;
  const unsigned long FETCH = 64;
  const unsigned long TOP_DOCUMENT = 128;
  const unsigned long SUBDOCUMENT = 256;
  const unsigned long WEBSOCKET = 512;
  const unsigned long PING = 1024;
  const unsigned long OTHER = 2048;
  const unsigned long ANY_PARTY = 0;
  const unsigned long FIRST_PARTY = 1;
  const unsigned long THIRD_PARTY = 2;
  /** Exactly one of urlPrefix/urlPattern is nonempty. Patterns use the
   * backend's supported regular-expression subset; compilation can reject them.
   * No unsupported predicate may be silently dropped. */
  readonly attribute AUTF8String urlPattern;
  readonly attribute boolean caseSensitive;
  /** block or allow. allow overrides preceding rules in this policy ONLY.
   * A later block can override an earlier allow. */
  readonly attribute AUTF8String action;
  /** Requesting document URL condition, not an inferred security origin.
   * Mutually exclusive with topURLPrefix. */
  readonly attribute AUTF8String documentURLPattern;
  readonly attribute boolean excludeDocumentURL;
  readonly attribute unsigned long party;
  /** Empty means any; canonical HTTP(S) top-level document prefix otherwise. */
  readonly attribute AUTF8String topURLPrefix;
  readonly attribute AUTF8String urlPrefix;
  readonly attribute unsigned long resourceTypes;
};
