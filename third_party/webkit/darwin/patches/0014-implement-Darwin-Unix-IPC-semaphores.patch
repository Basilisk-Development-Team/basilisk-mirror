+
 Semaphore::Semaphore()
 {
 #if OS(LINUX)
     m_fd = { eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK | EFD_SEMAPHORE), UnixFileDescriptor::Adopt };
+#elif OS(DARWIN)
+    m_sharedState = WebCore::SharedMemory::allocate(sizeof(SharedCounter));
+    if (!m_sharedState)
+        return;
+    new (m_sharedState->mutableSpan().data()) SharedCounter { 0 };
+    auto handle = m_sharedState->createHandle(WebCore::SharedMemory::Protection::ReadWrite);
+    if (!handle) {
+        m_sharedState = nullptr;
+        return;
+    }
+    m_fd = handle->releaseHandle();
 #endif
 }
 
 Semaphore::Semaphore(UnixFileDescriptor&& fd)
     : m_fd(WTF::move(fd))
-{ }
+{
+#if OS(DARWIN)
+    struct stat info;
+    if (!m_fd || fstat(m_fd.value(), &info) || info.st_size < static_cast<off_t>(sizeof(SharedCounter))) {
+        m_fd = { };
+        return;
+    }
+    m_sharedState = WebCore::SharedMemory::map(
+        WebCore::SharedMemory::Handle(m_fd.duplicate(), sizeof(SharedCounter)),
+        WebCore::SharedMemory::Protection::ReadWrite);
+    if (!m_sharedState)
+        m_fd = { };
+#endif
+}
 
