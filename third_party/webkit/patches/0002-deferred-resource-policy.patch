+#if PLATFORM(GTK) || PLATFORM(WPE)
+void NetworkProcessProxy::resourceLoadPolicyFinished(WebPageProxyIdentifier pageID, String&& identifier)
+{
+    RefPtr page = WebProcessProxy::webPage(pageID);
+    if (!page)
+        return;
+    auto snapshot = JSON::Object::create();
+    snapshot->setString("phase"_s, "complete"_s);
+    snapshot->setString("id"_s, identifier);
+    UserMessage message;
+    message.type = UserMessage::Type::Message;
+    message.name = "WebKitResourcePolicy";
+    message.parameters = g_variant_new("(s)", snapshot->toJSONString().utf8().data());
+    page->sendMessageToWebView(WTF::move(message));
+}
+
+void NetworkProcessProxy::decideResourceLoadPolicy(WebPageProxyIdentifier pageID, String&& snapshot, CompletionHandler<void(String&&)>&& completionHandler)
+{
+    RefPtr page = WebProcessProxy::webPage(pageID);
+    if (!page) {
+        completionHandler({ });
+        return;
+    }
+    UserMessage message;
+    message.type = UserMessage::Type::Message;
+    message.name = "WebKitResourcePolicy";
+    message.parameters = g_variant_new("(s)", snapshot.utf8().data());
+    page->sendMessageToWebViewWithReply(WTF::move(message), [completionHandler = WTF::move(completionHandler)](UserMessage&& reply) mutable {
+        if (reply.type != UserMessage::Type::Message || !reply.parameters || !g_variant_is_of_type(reply.parameters.get(), G_VARIANT_TYPE("(s)"))) {
+            completionHandler({ });
+            return;
+        }
+        const char* json;
+        g_variant_get(reply.parameters.get(), "(&s)", &json);
+        completionHandler(String::fromUTF8(json));
+    });
+}
+#endif
