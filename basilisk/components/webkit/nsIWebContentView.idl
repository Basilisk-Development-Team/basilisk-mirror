#include "nsISupports.idl"
interface mozIDOMWindowProxy;
interface nsIObserver;

/** Experimental chrome-only content view. No Gecko DOM/docshell contract.
 * All calls and callbacks occur on the main thread. The owner must destroy()
 * on window unload. Coordinates are device pixels, relative to
 * the chrome window's client area. Only an unobscured rectangular host in a
 * dedicated chrome window is supported initially.
 */
[scriptable, uuid(bf78b1c3-787d-48bb-810c-9d5d98eac5ce)]
interface nsIWebContentView : nsISupports
{
  /** listener topics: content-view-state (read state getters) and
   * content-view-process-terminated. Subject is this view.
   * content-view-context-menu carries an nsIPropertyBag2 subject with UTF-8
   * pageURL/linkURL/imageURL/mediaURL; boolean isLink/isImage/isMedia/
   * isEditable/hasSelection; and int32 x/y in host device pixels.
   * Selected text is not available in the prototype.
   */
  void attach(in mozIDOMWindowProxy window, in nsIObserver listener);
  void setBounds(in long x, in long y, in long width, in long height);
  void setVisible(in boolean visible);
  void focus();
  /** Idempotent. Disconnects callbacks and releases native/engine resources. */
  void destroy();

  void loadURI(in AUTF8String uri);
  void reload();
  void stop();
  void goBack();
  void goForward();
  readonly attribute boolean canGoBack;
  readonly attribute boolean canGoForward;
  readonly attribute AUTF8String currentURI;
  readonly attribute AUTF8String title;
};
