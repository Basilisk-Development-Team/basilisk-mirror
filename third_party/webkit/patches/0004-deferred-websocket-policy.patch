@@ -64,6 +70,11 @@
     if (!session)
         return;
 
+    auto startSocket = [this, frameID, pageID, protocol, clientOrigin, hadMainFrameMainResourcePrivateRelayed, allowPrivacyProxy, advancedPrivacyProtections, storedCredentialsPolicy, isInitiatedByDedicatedWorker](const ResourceRequest& request) {
+        auto* session = m_session.get();
+        if (!session || m_state != State::Open)
+            return;
+        auto webPageProxyID = m_webPageProxyID;
     m_socket = session->createWebSocketTask(webPageProxyID, frameID, pageID, *this, request, protocol, clientOrigin, hadMainFrameMainResourcePrivateRelayed, allowPrivacyProxy, advancedPrivacyProtections, storedCredentialsPolicy, isInitiatedByDedicatedWorker);
     if (RefPtr socket = m_socket.get()) {
 #if PLATFORM(COCOA)
@@ -71,10 +82,54 @@
 #endif
         socket->resume();
     }
+    };
+#if PLATFORM(GTK) || PLATFORM(WPE)
+    if (resourceLoadPolicyEnabled) {
+        auto snapshot = NetworkResourcePolicy::snapshot(request, { }, false);
+        snapshot->setString("id"_s, makeString("socket:"_s, identifier.toUInt64()));
+        snapshot->setString("frameId"_s, frameID ? String::number(frameID->toUInt64()) : emptyString());
+        snapshot->setString("parentFrameId"_s, parentFrameID ? String::number(parentFrameID->toUInt64()) : emptyString());
+        snapshot->setString("documentURL"_s, documentURL);
+        snapshot->setString("sourceOrigin"_s, clientOrigin.clientOrigin.toString());
+        snapshot->setString("topOrigin"_s, clientOrigin.topOrigin.toString());
+        snapshot->setInteger("type"_s, 15);
+        snapshot->setBoolean("mainResource"_s, false);
+        snapshot->setBoolean("mainFrame"_s, false);
+        m_policySnapshot = snapshot->toJSONString();
+        m_resourcePolicy = NetworkResourcePolicy::create([weakThis = WeakPtr { *this }, request = ResourceRequest { request }, startSocket = WTF::move(startSocket)](RefPtr<JSON::Object>&& decision) mutable {
+            if (!weakThis || weakThis->m_state != State::Open)
+                return;
+            RefPtr channel = weakThis.get();
+            if (decision && decision->getBoolean("allow"_s).value_or(false)) {
+                NetworkResourcePolicy::applyHeaders(request, *decision);
+                startSocket(request);
+                if (channel->m_socket)
+                    return;
+            }
+            channel->didReceiveMessageError("WebSocket blocked by resource policy"_s);
+            channel->didClose(1006, "Resource policy denied"_s);
+        });
+        return;
+    }
+#endif
+    startSocket(request);
+}
+
+void NetworkSocketChannel::startResourcePolicy()
+{
+#if PLATFORM(GTK) || PLATFORM(WPE)
+    if (m_resourcePolicy)
+        m_resourcePolicy->start(*m_connectionToWebProcess->networkProcess().parentProcessConnection(), m_webPageProxyID, m_policySnapshot);
+#endif
 }
 
 NetworkSocketChannel::~NetworkSocketChannel()
 {
+    m_state = State::Closed;
+#if PLATFORM(GTK) || PLATFORM(WPE)
+    if (m_resourcePolicy)
+        m_connectionToWebProcess->networkProcess().parentProcessConnection()->send(Messages::NetworkProcessProxy::ResourceLoadPolicyFinished(m_webPageProxyID, makeString("socket:"_s, m_identifier.toUInt64())), 0);
+#endif
     if (RefPtr socket = m_socket.get()) {
 #if PLATFORM(COCOA)
         if (RefPtr sessionSet = m_session ? socket->sessionSet() : nullptr)
@@ -86,11 +141,13 @@
 
 void NetworkSocketChannel::sendString(std::span<const uint8_t> message, CompletionHandler<void()>&& callback)
 {
+    if (!m_socket) { callback(); return; }
     protect(m_socket)->sendString(message, WTF::move(callback));
 }
 
 void NetworkSocketChannel::sendData(std::span<const uint8_t> data, CompletionHandler<void()>&& callback)
 {
+    if (!m_socket) { callback(); return; }
     protect(m_socket)->sendData(data, WTF::move(callback));
 }
 
@@ -107,6 +164,18 @@
 
 void NetworkSocketChannel::close(int32_t code, const String& reason)
 {
+    if (!m_socket) {
+        Ref protectedThis { *this };
+        m_state = State::Closed;
+        m_errorTimer.stop();
+#if PLATFORM(GTK) || PLATFORM(WPE)
+        if (m_resourcePolicy)
+            m_resourcePolicy->cancel();
+#endif
+        send(Messages::WebSocketChannel::DidClose { 1006, reason });
+        protect(m_connectionToWebProcess)->removeSocketChannel(m_identifier);
+        return;
+    }
     protect(m_socket)->close(code, reason);
     finishClosingIfPossible();
 }
