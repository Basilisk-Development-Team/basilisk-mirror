@@ -908,6 +916,10 @@
 #endif
     addParametersShared(protect(webFrame->coreLocalFrame()).get(), loadParameters);
 
+    if (RefPtr policyPage = webFrame->page(); loadParameters.resourceLoadPolicyEnabled && policyPage && !policyPage->injectedBundleResourceLoadClient().allowResourceLoad(*policyPage, *webFrame, request, static_cast<unsigned>(ResourceLoadInfo::typeForRequest(request.requester(), loadParameters.options.destination)))) {
