From: Basilisk contributors
Subject: [PATCH] Expose bounded synchronous content messages and frame user styles

diff --git a/Source/WebKit/UIProcess/WebPageProxy.h b/Source/WebKit/UIProcess/WebPageProxy.h
--- a/Source/WebKit/UIProcess/WebPageProxy.h
+++ b/Source/WebKit/UIProcess/WebPageProxy.h
@@ -3215,6 +3215,8 @@
     void revokeGeolocationAuthorizationToken(const String& authorizationToken);
 
 #if PLATFORM(GTK) || PLATFORM(WPE)
+    void sendMessageToWebViewSync(UserMessage&& message, CompletionHandler<void(UserMessage&&)>&& completion)
+    { sendMessageToWebViewWithReply(WTF::move(message), WTF::move(completion)); }
     void sendMessageToWebView(UserMessage&&);
     void sendMessageToWebViewWithReply(UserMessage&&, CompletionHandler<void(UserMessage&&)>&&);
 
diff --git a/Source/WebKit/UIProcess/WebPageProxy.messages.in b/Source/WebKit/UIProcess/WebPageProxy.messages.in
--- a/Source/WebKit/UIProcess/WebPageProxy.messages.in
+++ b/Source/WebKit/UIProcess/WebPageProxy.messages.in
@@ -614,6 +614,7 @@
 
 #if PLATFORM(GTK) || PLATFORM(WPE)
     SendMessageToWebView(struct WebKit::UserMessage userMessage)
+    SendMessageToWebViewSync(struct WebKit::UserMessage userMessage) -> (struct WebKit::UserMessage replyMessage) Synchronous
     SendMessageToWebViewWithReply(struct WebKit::UserMessage userMessage) -> (struct WebKit::UserMessage replyMessage)
 #endif
 
diff --git a/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.cpp b/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.cpp
--- a/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.cpp
+++ b/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.cpp
@@ -21,6 +21,11 @@
 #include "WebKitFrame.h"
 
 #include "WebKitFramePrivate.h"
+#include <WebCore/DocumentInlines.h>
+#include <WebCore/LocalFrameInlines.h>
+#include <WebCore/ExtensionStyleSheets.h>
+#include <WebCore/UserStyleSheet.h>
+#include <wtf/text/MakeString.h>
 #include "WebKitScriptWorldPrivate.h"
 #include "WebKitWebFormManagerPrivate.h"
 #include <JavaScriptCore/APICast.h>
@@ -320,3 +325,28 @@
     return jsValue ? jscContextGetOrCreateValue(jsContext.get(), jsValue).leakRef() : nullptr;
 }
 #endif
+
+// Parent identifiers are engine-provided, including same-URL sibling frames.
+guint64 webkit_frame_get_parent_id(WebKitFrame* frame)
+{
+    g_return_val_if_fail(WEBKIT_IS_FRAME(frame), 0);
+    auto parent = frame->priv->webFrame->parentFrame();
+    return parent ? parent->frameID().toUInt64() : 0;
+}
+
+void webkit_frame_set_user_style(WebKitFrame* frame, const char* identifier, const char* source)
+{
+    g_return_if_fail(WEBKIT_IS_FRAME(frame));
+    g_return_if_fail(identifier && *identifier);
+    auto* coreFrame = frame->priv->webFrame->coreLocalFrame();
+    if (!coreFrame || !coreFrame->document())
+        return;
+    Ref document = *coreFrame->document();
+    URL key { String::fromUTF8(identifier) };
+    if (!key.isValid())
+        key = URL { makeString("webkit-user-style:"_s, String::fromUTF8(identifier)) };
+    UserStyleSheet sheet { String::fromUTF8(source ? source : ""), key };
+    document->extensionStyleSheets().removePageSpecificUserStyleSheet(sheet);
+    if (source)
+        document->extensionStyleSheets().injectPageSpecificUserStyleSheet(sheet);
+}
diff --git a/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.h.in b/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.h.in
--- a/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.h.in
+++ b/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitFrame.h.in
@@ -93,6 +93,15 @@
                                                           WebKitScriptWorld *world);
 #endif
 
+WEBKIT_API guint64
+webkit_frame_get_parent_id (WebKitFrame *frame);
+
+/* Document-lifetime user-origin styles. Replacement/removal uses an embedder
+ * identifier; no style element is exposed to page JavaScript. */
+WEBKIT_API void
+webkit_frame_set_user_style (WebKitFrame *frame, const char *identifier,
+                             const char *source);
+
 G_END_DECLS
 
 #endif
diff --git a/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitWebPage.cpp b/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitWebPage.cpp
--- a/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitWebPage.cpp
+++ b/Source/WebKit/WebProcess/InjectedBundle/API/glib/WebKitWebPage.cpp
@@ -48,6 +48,7 @@
 #include "WebProcess.h"
 #include <WebCore/ContextMenuContext.h>
 #include <WebCore/Document.h>
+#include <WebCore/UserScript.h>
 #include <WebCore/DocumentLoader.h>
 #include <WebCore/FrameDestructionObserver.h>
 #include <WebCore/FrameLoader.h>
@@ -932,6 +933,20 @@
  *
  * Since: 2.28
  */
+WebKitUserMessage* webkit_web_page_send_message_to_view_sync(WebKitWebPage* webPage, WebKitUserMessage* message, GError** error)
+{
+    g_return_val_if_fail(WEBKIT_IS_WEB_PAGE(webPage), nullptr);
+    g_return_val_if_fail(WEBKIT_IS_USER_MESSAGE(message), nullptr);
+    GRefPtr<WebKitUserMessage> adoptedMessage = message;
+    auto result = webPage->priv->webPage->sendSync(Messages::WebPageProxy::SendMessageToWebViewSync(webkitUserMessageGetMessage(message)), 10_s);
+    auto [reply] = result.takeReplyOr(UserMessage { });
+    if (reply.type != UserMessage::Type::Message) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED, "Host service did not reply");
+        return nullptr;
+    }
+    return WEBKIT_USER_MESSAGE(g_object_ref_sink(webkitUserMessageCreate(WTF::move(reply))));
+}
+
 void webkit_web_page_send_message_to_view(WebKitWebPage* webPage, WebKitUserMessage* message, GCancellable* cancellable, GAsyncReadyCallback callback, gpointer userData)
 {
     g_return_if_fail(WEBKIT_IS_WEB_PAGE(webPage));
@@ -1008,3 +1023,12 @@
 
     return addResult.iterator->value.get();
 }
+
+void webkit_web_page_add_user_script(WebKitWebPage* webPage, WebKitScriptWorld* world, const char* source, gboolean atDocumentEnd)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_PAGE(webPage));
+    g_return_if_fail(WEBKIT_IS_SCRIPT_WORLD(world));
+    g_return_if_fail(source);
+    webPage->priv->webPage->addUserScript(String::fromUTF8(source), *webkitScriptWorldGetInjectedBundleScriptWorld(world),
+        UserContentInjectedFrames::InjectInAllFrames, atDocumentEnd ? UserScriptInjectionTime::DocumentEnd : UserScriptInjectionTime::DocumentStart);
+}
