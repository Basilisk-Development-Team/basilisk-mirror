new file mode 100644
--- /dev/null
+++ b/Source/WebKit/NetworkProcess/NetworkResourcePolicy.h
@@ -0,0 +1,78 @@
+/* Generic, opt-in embedder resource policy. Copyright 2026.
+ * Distributed under the BSD 2-Clause license, like the surrounding WebKit code.
+ */
+#pragma once
+
+#include "NetworkProcessProxyMessages.h"
+#include <WebCore/ResourceRequest.h>
+#include <WebCore/ResourceResponse.h>
+#include <WebCore/Timer.h>
+#include <wtf/JSONValues.h>
+#include <wtf/WeakPtr.h>
+#include <wtf/RefCounted.h>
+#include <wtf/FastMalloc.h>
+
+namespace WebKit {
+
+// Owned by the actual loader. A timed-out, cancelled or destroyed decision can
+// never resume it. IPC callbacks retain only a weak decision reference.
+class NetworkResourcePolicy : public RefCounted<NetworkResourcePolicy>, public CanMakeWeakPtr<NetworkResourcePolicy> {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(NetworkResourcePolicy);
+public:
+    using Completion = CompletionHandler<void(RefPtr<JSON::Object>&&)>;
+    static Ref<NetworkResourcePolicy> create(Completion&& completion)
+    { return adoptRef(*new NetworkResourcePolicy(WTF::move(completion))); }
+    explicit NetworkResourcePolicy(Completion&& completion)
+        : m_timer(*this, &NetworkResourcePolicy::timedOut)
+        , m_completion(WTF::move(completion)) { }
+    ~NetworkResourcePolicy() { if (auto completion = std::exchange(m_completion, { })) completion(nullptr); }
+
+    void start(IPC::Connection& connection, WebPageProxyIdentifier page, const String& snapshot)
+    {
+        m_timer.startOneShot(30_s);
+        connection.sendWithAsyncReply(Messages::NetworkProcessProxy::DecideResourceLoadPolicy(page, snapshot), [weakThis = WeakPtr { *this }](String&& decision) {
+            if (!weakThis)
+                return;
+            auto value = decision.length() <= 1024 * 1024 ? JSON::Value::parseJSON(decision) : nullptr;
+            weakThis->finish(value ? value->asObject() : nullptr);
+        }, 0);
+    }
+    void cancel() { finish(nullptr); }
+    static Ref<JSON::Object> snapshot(const WebCore::ResourceRequest& request, const WebCore::ResourceResponse& response, bool isResponse)
+    {
+        auto result = JSON::Object::create();
+        result->setString("phase"_s, isResponse ? "response"_s : "request"_s);
+        result->setString("url"_s, request.url().string());
+        result->setString("method"_s, request.httpMethod());
+        result->setInteger("status"_s, response.httpStatusCode());
+        auto headers = JSON::Object::create();
+        for (const auto& header : isResponse ? response.httpHeaderFields() : request.httpHeaderFields())
+            headers->setString(header.key, header.value);
+        result->setObject("headers"_s, WTF::move(headers));
+        return result;
+    }
+    template<typename T> static void applyHeaders(T& target, JSON::Object& decision)
+    {
+        if (auto headers = decision.getObject("headers"_s)) {
+            target.setHTTPHeaderFields({ });
+            for (const auto& entry : *headers) {
+                auto value = entry.value->asString();
+                if (!value.isNull() && !entry.key.contains('\r') && !entry.key.contains('\n') && !value.contains('\r') && !value.contains('\n'))
+                    target.setHTTPHeaderField(entry.key, value);
+            }
+        }
+    }
+private:
+    void timedOut() { finish(nullptr); }
+    void finish(RefPtr<JSON::Object>&& decision)
+    {
+        Ref protectedThis { *this };
+        m_timer.stop();
+        // The completion may destroy this decision and its loader.
+        if (auto completion = std::exchange(m_completion, { }))
+            completion(WTF::move(decision));
+    }
+    WebCore::Timer m_timer;
+    Completion m_completion;
+};
+}
